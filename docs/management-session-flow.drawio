        <mxCell id="16" value="准备范围与连接" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;entryX=0.25;entryY=0;dashed=1;labelBackgroundColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=14;" edge="1" parent="1" source="3" target="7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="17" value="只调用已授权工具" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.75;entryY=0;labelBackgroundColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=14;" edge="1" parent="1" source="4" target="7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="540" /><mxPoint x="760" y="540" /></Array></mxGeometry></mxCell>
        <mxCell id="18" value="本机" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;startArrow=block;endArrow=block;labelBackgroundColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=14;" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="19" value="标准 SSH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;startArrow=block;endArrow=block;labelBackgroundColor=#ffffff;fontFamily=Microsoft YaHei;fontSize=14;" edge="1" parent="1" source="7" target="9"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="20" value="约束：切换入口不新建 Captain，不重启工作 agent，不重发未知结果任务。&#xa;桌面交接需验证同一 Session 和工具；新建深链接仅预填草稿，不等于模型已经启动。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1900" height="100" as="geometry" /></mxCell>
