        <mxCell id="2" value="AgentCaptain 首页&#xa;启动或继续管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="3" value="初始化与恢复&#xa;工作区 角色 工具 范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Microsoft YaHei;fontSize=18;" vertex="1" parent="1"><mxGeometry x="550" y="340" width="280" height="90" as="geometry" /></mxCell>
        <mxCell id="4" value="本机原生管理会话&#xa;准确 Session ID 持久历史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1110" y="340" width="300" height="90" as="geometry" /></mxCell>
        <mxCell id="5" value="桌面交流入口&#xa;验证后继续同一会话" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1110" y="70" width="300" height="70" as="geometry" /></mxCell>
        <mxCell id="6" value="Captain 管理终端&#xa;可用的备用入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1690" y="340" width="260" height="90" as="geometry" /></mxCell>
        <mxCell id="7" value="Captain 管理工具&#xa;身份 范围 送达 真实输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Microsoft YaHei;fontSize=18;" vertex="1" parent="1"><mxGeometry x="550" y="630" width="280" height="90" as="geometry" /></mxCell>
        <mxCell id="8" value="本机工作会话&#xa;原终端 原工作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft YaHei;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="230" height="90" as="geometry" /></mxCell>
