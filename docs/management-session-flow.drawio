        <mxCell id="10" value="AgentCaptain 管理会话方案" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft YaHei;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="50" as="geometry" /></mxCell>
        <mxCell id="11" value="历史设计提案（供参考）&#xa;&#xa;主控是用户本机的真实对话，不另跑一个 Captain 模型。&#xa;用户确认管理范围，实际工程工作交给工作会话。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="790" height="170" as="geometry" /></mxCell>
