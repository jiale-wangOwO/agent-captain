  <diagram id="management-session-product" name="管理会话产品方案">
    <mxGraphModel dx="2040" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="1000" background="#ffffff">
      <root>
        <mxCell id="0" />
